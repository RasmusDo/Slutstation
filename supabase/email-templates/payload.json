{"mailer_subjects_confirmation":"Confirm your email — Slutstation","mailer_templates_confirmation_content":"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<meta name=\"color-scheme\" content=\"dark\" />\n<meta name=\"supported-color-schemes\" content=\"dark\" />\n<title>Confirm your email</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#0a0b0f;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">One step left. Click below to activate your account &mdash; that also registers your membership of Kulturf&ouml;reningen Musikbopp. Membership is free and runs to the end of the calendar year; everyone renews in January, whenever they joined.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#0a0b0f;\">\n<tr><td align=\"center\" style=\"padding:36px 16px;\">\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#101219;border:1px solid #23262f;border-radius:14px;\">\n    <tr><td align=\"center\" style=\"padding:34px 32px 8px;\">\n      <div style=\"font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;letter-spacing:0.34em;color:#f4f5f7;text-transform:uppercase;\">Slutstation</div>\n    </td></tr>\n    <tr><td align=\"center\" style=\"padding:0 32px 4px;\">\n      <div style=\"font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:0.16em;color:#ff2a2a;text-transform:uppercase;\">Membership</div>\n    </td></tr>\n    <tr><td style=\"padding:20px 32px 0;\">\n      <h1 style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:26px;line-height:1.2;font-weight:600;color:#f4f5f7;letter-spacing:-0.02em;\">Confirm your email</h1>\n    </td></tr>\n    <tr><td style=\"padding:16px 32px 22px;\">\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#c7cad2;\">One step left. Click below to activate your account &mdash; that also registers your membership of Kulturf&ouml;reningen Musikbopp. Membership is free and runs to the end of the calendar year; everyone renews in January, whenever they joined.</p>\n    </td></tr>\n    <tr><td align=\"left\" style=\"padding:0 32px 6px;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr><td align=\"center\" bgcolor=\"#ff2a2a\" style=\"border-radius:100px;\">\n          <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 30px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:100px;\">Confirm my email</a>\n        </td></tr>\n      </table>\n    </td></tr>\n    <tr><td style=\"padding:18px 32px 0;\">\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#83879a;word-break:break-all;\">\n        Button not working? Copy this link:<br /><a href=\"{{ .ConfirmationURL }}\" style=\"color:#ff2a2a;\">{{ .ConfirmationURL }}</a>\n      </p>\n    </td></tr>\n    <tr><td style=\"padding:26px 32px 0;\"><div style=\"height:1px;background-color:#23262f;line-height:1px;font-size:0;\">&nbsp;</div></td></tr>\n    <tr><td style=\"padding:20px 32px 34px;\">\n      <p style=\"margin:0 0 10px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#83879a;\">Didn&rsquo;t request this? Ignore this email and nothing happens.</p>\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#6b6f80;\">\n        Kulturf&ouml;reningen Musikbopp &middot; Tyres&ouml; &middot; <a href=\"mailto:info@slutstation.se\" style=\"color:#83879a;\">info@slutstation.se</a>\n      </p>\n    </td></tr>\n  </table>\n</td></tr>\n</table>\n</body>\n</html>","mailer_subjects_recovery":"Reset your password — Slutstation","mailer_templates_recovery_content":"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<meta name=\"color-scheme\" content=\"dark\" />\n<meta name=\"supported-color-schemes\" content=\"dark\" />\n<title>Choose a new password</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#0a0b0f;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">Click below to set a new password for your account. The link works once and expires shortly.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#0a0b0f;\">\n<tr><td align=\"center\" style=\"padding:36px 16px;\">\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#101219;border:1px solid #23262f;border-radius:14px;\">\n    <tr><td align=\"center\" style=\"padding:34px 32px 8px;\">\n      <div style=\"font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;letter-spacing:0.34em;color:#f4f5f7;text-transform:uppercase;\">Slutstation</div>\n    </td></tr>\n    <tr><td align=\"center\" style=\"padding:0 32px 4px;\">\n      <div style=\"font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:0.16em;color:#ff2a2a;text-transform:uppercase;\">Password</div>\n    </td></tr>\n    <tr><td style=\"padding:20px 32px 0;\">\n      <h1 style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:26px;line-height:1.2;font-weight:600;color:#f4f5f7;letter-spacing:-0.02em;\">Choose a new password</h1>\n    </td></tr>\n    <tr><td style=\"padding:16px 32px 22px;\">\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#c7cad2;\">Click below to set a new password for your account. The link works once and expires shortly.</p>\n    </td></tr>\n    <tr><td align=\"left\" style=\"padding:0 32px 6px;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr><td align=\"center\" bgcolor=\"#ff2a2a\" style=\"border-radius:100px;\">\n          <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 30px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:100px;\">Set a new password</a>\n        </td></tr>\n      </table>\n    </td></tr>\n    <tr><td style=\"padding:18px 32px 0;\">\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#83879a;word-break:break-all;\">\n        Button not working? Copy this link:<br /><a href=\"{{ .ConfirmationURL }}\" style=\"color:#ff2a2a;\">{{ .ConfirmationURL }}</a>\n      </p>\n    </td></tr>\n    <tr><td style=\"padding:26px 32px 0;\"><div style=\"height:1px;background-color:#23262f;line-height:1px;font-size:0;\">&nbsp;</div></td></tr>\n    <tr><td style=\"padding:20px 32px 34px;\">\n      <p style=\"margin:0 0 10px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#83879a;\">Didn&rsquo;t request this? Ignore this email and nothing happens.</p>\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#6b6f80;\">\n        Kulturf&ouml;reningen Musikbopp &middot; Tyres&ouml; &middot; <a href=\"mailto:info@slutstation.se\" style=\"color:#83879a;\">info@slutstation.se</a>\n      </p>\n    </td></tr>\n  </table>\n</td></tr>\n</table>\n</body>\n</html>","mailer_subjects_magic_link":"Your sign-in link — Slutstation","mailer_templates_magic_link_content":"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<meta name=\"color-scheme\" content=\"dark\" />\n<meta name=\"supported-color-schemes\" content=\"dark\" />\n<title>Sign in to your account</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#0a0b0f;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">Here is your sign-in link. It works once and expires shortly.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#0a0b0f;\">\n<tr><td align=\"center\" style=\"padding:36px 16px;\">\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#101219;border:1px solid #23262f;border-radius:14px;\">\n    <tr><td align=\"center\" style=\"padding:34px 32px 8px;\">\n      <div style=\"font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;letter-spacing:0.34em;color:#f4f5f7;text-transform:uppercase;\">Slutstation</div>\n    </td></tr>\n    <tr><td align=\"center\" style=\"padding:0 32px 4px;\">\n      <div style=\"font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:0.16em;color:#ff2a2a;text-transform:uppercase;\">Sign in</div>\n    </td></tr>\n    <tr><td style=\"padding:20px 32px 0;\">\n      <h1 style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:26px;line-height:1.2;font-weight:600;color:#f4f5f7;letter-spacing:-0.02em;\">Sign in to your account</h1>\n    </td></tr>\n    <tr><td style=\"padding:16px 32px 22px;\">\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#c7cad2;\">Here is your sign-in link. It works once and expires shortly.</p>\n    </td></tr>\n    <tr><td align=\"left\" style=\"padding:0 32px 6px;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr><td align=\"center\" bgcolor=\"#ff2a2a\" style=\"border-radius:100px;\">\n          <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 30px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:100px;\">Sign in</a>\n        </td></tr>\n      </table>\n    </td></tr>\n    <tr><td style=\"padding:18px 32px 0;\">\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#83879a;word-break:break-all;\">\n        Button not working? Copy this link:<br /><a href=\"{{ .ConfirmationURL }}\" style=\"color:#ff2a2a;\">{{ .ConfirmationURL }}</a>\n      </p>\n    </td></tr>\n    <tr><td style=\"padding:26px 32px 0;\"><div style=\"height:1px;background-color:#23262f;line-height:1px;font-size:0;\">&nbsp;</div></td></tr>\n    <tr><td style=\"padding:20px 32px 34px;\">\n      <p style=\"margin:0 0 10px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#83879a;\">Didn&rsquo;t request this? Ignore this email and nothing happens.</p>\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#6b6f80;\">\n        Kulturf&ouml;reningen Musikbopp &middot; Tyres&ouml; &middot; <a href=\"mailto:info@slutstation.se\" style=\"color:#83879a;\">info@slutstation.se</a>\n      </p>\n    </td></tr>\n  </table>\n</td></tr>\n</table>\n</body>\n</html>","mailer_subjects_email_change":"Confirm your new email — Slutstation","mailer_templates_email_change_content":"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<meta name=\"color-scheme\" content=\"dark\" />\n<meta name=\"supported-color-schemes\" content=\"dark\" />\n<title>Confirm your new email</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#0a0b0f;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">You asked us to change the email address on your account to {{ .NewEmail }}. Click below to confirm the change.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#0a0b0f;\">\n<tr><td align=\"center\" style=\"padding:36px 16px;\">\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#101219;border:1px solid #23262f;border-radius:14px;\">\n    <tr><td align=\"center\" style=\"padding:34px 32px 8px;\">\n      <div style=\"font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;letter-spacing:0.34em;color:#f4f5f7;text-transform:uppercase;\">Slutstation</div>\n    </td></tr>\n    <tr><td align=\"center\" style=\"padding:0 32px 4px;\">\n      <div style=\"font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:0.16em;color:#ff2a2a;text-transform:uppercase;\">Account</div>\n    </td></tr>\n    <tr><td style=\"padding:20px 32px 0;\">\n      <h1 style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:26px;line-height:1.2;font-weight:600;color:#f4f5f7;letter-spacing:-0.02em;\">Confirm your new email</h1>\n    </td></tr>\n    <tr><td style=\"padding:16px 32px 22px;\">\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#c7cad2;\">You asked us to change the email address on your account to <strong style=\"color:#f4f5f7;\">{{ .NewEmail }}</strong>. Click below to confirm the change.</p>\n    </td></tr>\n    <tr><td align=\"left\" style=\"padding:0 32px 6px;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr><td align=\"center\" bgcolor=\"#ff2a2a\" style=\"border-radius:100px;\">\n          <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 30px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:100px;\">Confirm the change</a>\n        </td></tr>\n      </table>\n    </td></tr>\n    <tr><td style=\"padding:18px 32px 0;\">\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#83879a;word-break:break-all;\">\n        Button not working? Copy this link:<br /><a href=\"{{ .ConfirmationURL }}\" style=\"color:#ff2a2a;\">{{ .ConfirmationURL }}</a>\n      </p>\n    </td></tr>\n    <tr><td style=\"padding:26px 32px 0;\"><div style=\"height:1px;background-color:#23262f;line-height:1px;font-size:0;\">&nbsp;</div></td></tr>\n    <tr><td style=\"padding:20px 32px 34px;\">\n      <p style=\"margin:0 0 10px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.6;color:#83879a;\">Didn&rsquo;t ask for this? Email us straight away at info@slutstation.se &mdash; somebody may be trying to take over your account.</p>\n      <p style=\"margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#6b6f80;\">\n        Kulturf&ouml;reningen Musikbopp &middot; Tyres&ouml; &middot; <a href=\"mailto:info@slutstation.se\" style=\"color:#83879a;\">info@slutstation.se</a>\n      </p>\n    </td></tr>\n  </table>\n</td></tr>\n</table>\n</body>\n</html>"}