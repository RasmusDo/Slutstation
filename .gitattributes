# Auto detect text files and normalize line endings
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf
deploy.sh text eol=lf

# Code files
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
